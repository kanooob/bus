<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- En-tête : Icône bus/GPS, nom de l'arrêt, statut temps réel et actions rapides -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_icon_bus_container"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_bus_badge_bg">

            <ImageView
                android:id="@+id/widget_icon_bus"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Idelis Bus"
                android:src="@drawable/ic_widget_bus" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_title_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_stop_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pôle Bosquet"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_live_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="En direct"
                    android:src="@drawable/widget_live_dot" />

                <TextView
                    android:id="@+id/widget_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Temps réel"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Boutons d'actions rapides indépendants : Favori suivant, Actualiser, Menu -->
        <LinearLayout
            android:id="@+id/widget_actions_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_btn_cycle_stop"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_action_pill_dark"
                android:contentDescription="Passer à l'arrêt favori suivant"
                android:padding="6dp"
                android:src="@drawable/ic_widget_swap"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_action_pill_dark"
                android:contentDescription="Actualiser les horaires"
                android:padding="6dp"
                android:src="@drawable/ic_widget_refresh" />

            <ImageView
                android:id="@+id/widget_btn_configure"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_action_pill_dark"
                android:contentDescription="Menu et configuration du widget"
                android:padding="6dp"
                android:src="@drawable/ic_widget_tune" />
        </LinearLayout>
    </LinearLayout>

    <!-- Séparateur compatible RemoteViews -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="6dp"
        android:background="#2A3A52"
